################################################################################
# Combinations C(n,k) solution
# Nicholas Maki
################################################################################

################################################################################
# register usage
# STUDENTS MUST EXPLAIN ALL REGISTERS THEY USE AND FOR WHAT PURPOSE HERE
################################################################################

# r0   = constant 0 (unused but reserved)
# r1   = temporary / loop diff
# r2   = function argument x
# r3   = factorial return value
# r4   = n (user input)
# r5   = k (user input)
# r6   = temp for validation (k - n)
# r7   = n! result
# r8   = k! result
# r9   = (n - k)
# r10  = (n - k)! result
# r11  = denominator (k! * (n-k)!)
# r12  = final C(n,k)
# r13  = loop variable (i) inside factorial
# r14  = return address register for calln
# r15  = stack pointer

# STUIDENTS NEED TO ADD THEIR OWN ASSEMBLY CODE HERE

################################################################################

0 setn r15 120 # Initializing stack pointer

#User input#
1 read r4         # reads input for n
2 read r5         # reads input for k

#Validating inputs#
3 jltzn r4 21     # If n < 0 -> invalid 
4 jeqzn r4 21     # If n == 0 -> invalid
5 jltzn r5 21     # If k < 0 -> invalid
6 jltzn r5 21     # If k == 0 -> invalid

#Computing n!#
7 copy r2 r4      # Move n into factorial argument 
8 calln r14 24    # Call factorial function
9 copy r7 r3      # Store n! into r7

#Computing k!#
10 copy r2 r5     # Move k into argument
11 calln r14 24   # Call factorial function
12 copy r8 r3     # Store k! into r8

#Computing (n-k)!#
13 sub r9 r4 r5   # r9 = n - k
14 copy r2 r9     # Pushhing (n-k) into argument
15 calln r14 24   # Call factorial function
16 copy r10 r3    # Store (n-k)! into r19

#Final calculations#
17 mul r11 r8 r10 # denominator = k! * (n-k)!
18 div r12 r7 r11 # result = n! / denominator
19 write r12      # #Outputting result
20 halt           

#Handling invalid inputs#
21 setn r12 -1    # Output -1 for invalid inputs
22 write r12
23 halt

#Factorial function#
24 pushr r14 r15  # Saving return address onto stack

25 jltzn r2 34    # If x < 0 -> return base case
26 jeqzn r2 34    # If x == 0 -> return base case
27 setn r3 1      # result = 1
28 setn r13 1     # i = 1

#Factorial loop segment#
29 addn r13 1     # i = i + 1
30 sub r1 r13 r2  # r1 = i - x
31 jgtzn r1 35    # If i > x -> done
32 mul r3 r3 r13  # result *= i
33 jumpn 29       # loop again

#Base case#
34 popr r14 r15
35 jumpr r14
36 setn r3 1      # Factorial(0 or negative) = 1

#Function end#
37 popr r14 r15   # Restore return address
38 jumpr r14      # Return to caller